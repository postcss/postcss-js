{
  "name": "postcss-js",
  "version": "5.1.0",
  "description": "PostCSS for CSS-in-JS and styles in JS objects",
  "keywords": [
    "css",
    "cssinjs",
    "inline",
    "js",
    "postcss",
    "postcss-runner",
    "react"
  ],
  "license": "MIT",
  "author": "Andrey Sitnik <andrey@sitnik.es>",
  "repository": "postcss/postcss-js",
  "funding": [
    {
      "type": "opencollective",
      "url": "https://opencollective.com/postcss/"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/ai"
    }
  ],
  "exports": {
    ".": {
      "require": "./index.js",
      "import": "./index.mjs"
    },
    "./package.json": "./package.json",
    "./async": "./async.js",
    "./objectifier": "./objectifier.js",
    "./parser": "./parser.js",
    "./process-result": "./process-result.js",
    "./sync": "./sync.js"
  },
  "scripts": {
    "test:coverage": "pnpm bnt --coverage 100",
    "test:lint": "oxlint",
    "test": "pnpm run /^test:/"
  },
  "devDependencies": {
    "@logux/oxc-configs": "^1.2.0",
    "better-node-test": "^1.0.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "postcss": "^8.5.33",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "postcss": "^8.4.21"
  },
  "engines": {
    "node": "^20 || ^22 || >= 24"
  }
}
